////////////////////////////////////////////////////////////
// RELACIONES
////////////////////////////////////////////////////////////


// Convocatorias

Ref: selec_convocatorias.con_tco_ide > selec_tipos_convocatoria.tco_ide
Ref: selec_convocatorias.con_eco_ide > selec_estados_convocatoria.eco_ide

Ref: selec_convocatoria_documentos.cod_con_ide > selec_convocatorias.con_ide


